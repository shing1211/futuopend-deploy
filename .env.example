# FutuOpenD runtime configuration
# Copy to .env and fill in your values.

# Futu account — v10.10+ uses remember-login (credentials cached after first run)
FUTU_ACCOUNT=your_account_id

# Bind address inside the container (0.0.0.0 so published ports work)
FUTU_IP=0.0.0.0

# Telnet debug/2FA interface (first-login SMS/CAPTCHA).
#
# FUTU_TELNET_IP binds INSIDE the container and must stay 0.0.0.0 for a
# published port to reach it. It does not control host exposure --
# FUTU_TELNET_BIND below does. Telnet is plaintext, so keep that on loopback.
FUTU_TELNET_IP=0.0.0.0
FUTU_TELNET_PORT=22222
FUTU_TELNET_BIND=127.0.0.1

# Host-side port bindings. This is the real security boundary.
#
#   127.0.0.1 (default) exposes nothing. Reach the API over an SSH tunnel:
#       ssh -N -L 11113:127.0.0.1:11113 user@host
#
#   0.0.0.0 makes the API directly reachable, and requires an RSA key
#   (FUTU_RSA_KEY below) for trading, with clients setting is_encrypt=True.
#   Read docs/security.md before exposing this.
FUTU_API_BIND=127.0.0.1
FUTU_API_PORT_HOST=11113
FUTU_WS_BIND=127.0.0.1

# RSA private key path inside the container (mounted from secrets/)
FUTU_RSA_KEY=/run/secrets/rsa_key.txt

# Futures trading API time zone (required for futures accounts)
FUTU_FUTURE_TZ=UTC+8

# Phone-number login area code (HK default; e.g. +86, +1)
FUTU_AREA_CODE=+852

# WebSocket endpoint (off by default; set a port to enable)
# FUTU_WS_IP=0.0.0.0
# FUTU_WS_PORT=11112

# Language: en (English) or chs (Simplified Chinese)
FUTU_LANG=en

# Log level: debug, info, warning, error, fatal
FUTU_LOG_LEVEL=info

# Container timezone
TZ=Asia/Hong_Kong

# Target architecture for image pull (amd64 or arm64)
PLATFORM=amd64

# Docker image to use (leave unset for default shing1211/futuopend:latest)
# Pin a specific version: FUTU_IMAGE=shing1211/futuopend:10.11.7108-ubuntu-amd64
FUTU_IMAGE=shing1211/futuopend:latest

# Push protocol format: 0 = protobuf (default), 1 = JSON
FUTU_PUSH_PROTO=0

# Disable FutuOpenD's internal watchdog so Docker owns restarts (default 1)
FUTU_NO_MONITOR=1
