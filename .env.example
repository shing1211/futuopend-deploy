# FutuOpenD runtime configuration
# Copy to .env and fill in your values.

# Your Futu account ID, phone number, or email
FUTU_ACCOUNT=your_account_id

# Login password as MD5 hex (32 chars). Generate:
#   python3 -c "import hashlib; print(hashlib.md5(b'your_password').hexdigest())"
FUTU_PWD_MD5=your_md5_hash_here

# Language: en (English) or chs (Simplified Chinese)
FUTU_LANG=en

# Log level: debug, info, warning, error, fatal
FUTU_LOG_LEVEL=info

# Container timezone
TZ=Asia/Hong_Kong

# Target architecture for image pull (amd64 or arm64)
PLATFORM=amd64

# Docker image to use (leave unset for default shing1211/futuopend:latest)
# Pin a specific version: FUTU_IMAGE=shing1211/futuopend:10.6.6608-ubuntu-amd64
FUTU_IMAGE=shing1211/futuopend:latest

# Push protocol format: 0 = protobuf (default), 1 = JSON
FUTU_PUSH_PROTO=0
